# Script mode (cmake -P): write OUTPUT, a header defining OSC_REVISION as the
# source tree's human-readable `git describe --always --dirty`, and
# OSC_SOURCE_ID as its full commit id with a suffix for tracked changes.
# Both are "unknown" outside git. Replay/save identities must not depend on
# local tags, clone depth or the configured Git abbreviation length.
#
# Run at every build (the osc_revision target), so the revision never goes
# stale as commits land. The header is rewritten only when the revision
# changes, so an unchanged one recompiles nothing.
#
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P OscRevision.cmake

execute_process(
    COMMAND git describe --always --dirty
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE revision
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE result
    ERROR_QUIET)
if(NOT result EQUAL 0 OR revision STREQUAL "")
    set(revision "unknown")
endif()

execute_process(
    COMMAND git rev-parse --verify HEAD
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE source_id
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE result
    ERROR_QUIET)
if(NOT result EQUAL 0 OR source_id STREQUAL "")
    set(source_id "unknown")
else()
    # Porcelain status refreshes the index before comparing contents, so a
    # timestamp-only change does not mark a clean checkout dirty. Include
    # staged and unstaged changes, but ignore untracked files even in submodules.
    execute_process(
        COMMAND git status --porcelain=v1 --untracked-files=no --ignore-submodules=untracked
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE tracked_changes
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE result
        ERROR_QUIET)
    if(NOT result EQUAL 0)
        set(source_id "unknown")
    elseif(NOT tracked_changes STREQUAL "")
        string(APPEND source_id "-dirty")
    endif()
endif()

set(content "// Generated by cmake/OscRevision.cmake: do not edit.\n#define OSC_REVISION \"${revision}\"\n#define OSC_SOURCE_ID \"${source_id}\"\n")
set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
